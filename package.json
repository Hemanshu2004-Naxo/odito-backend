{
  "name": "odito-backend",
  "version": "1.0.0",
  "description": "Odito Backend API Server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node src/workers/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:gbp": "node --test",
    "test:jobs": "node test-job-queue.mjs",
    "test:ai-visibility": "node --test --test-concurrency=1 \"src/modules/ai_visibility/**/*.test.js\"",
    "test:login": "node test-login.mjs",
    "seed:jobs": "node seeds/jobTypesSeed.js",
    "seed:system-admin": "node src/modules/user/scripts/seedSystemAdmin.js",
    "seed:ranking-history": "node src/modules/app_user/scripts/seedRankingHistory.js",
    "migrate:split-google-visibility": "node src/modules/app_user/scripts/splitGoogleVisibilityConnections.js",
    "migrate:backfill-recrawl-quota": "node src/modules/app_user/scripts/backfillRecrawlQuota.js",
    "report:project-profiles": "node src/modules/app_user/scripts/reportProjectProfileIssues.js",
    "visibility:reanalyze": "node src/modules/ai_visibility/scripts/reanalyzeEvidence.js",
    "visibility:evaluate": "node src/modules/ai_visibility/scripts/evaluateModels.js",
    "inspect:social-indexes": "node src/modules/social_meta/scripts/inspectSocialAiIndexes.js",
    "package:seo-bridge-plugin": "node src/modules/external_integration/scripts/packageSeoBridgePlugin.js",
    "load:smoke": "node load-tests/index.js --level=smoke",
    "load:light": "node load-tests/index.js --level=light",
    "load:medium": "node load-tests/index.js --level=medium",
    "load:heavy": "node load-tests/index.js --level=heavy",
    "load:stress": "node load-tests/index.js --level=stress",
    "load:spike": "node load-tests/index.js --level=spike",
    "load:mixed": "node load-tests/index.js --level=smoke --test=mixed",
    "load:duplicate": "node load-tests/index.js --test=duplicate",
    "load:rate-limit": "node load-tests/index.js --test=rate-limit",
    "load:soak": "node load-tests/index.js --level=smoke --test=soak --gap=30",
    "load:all": "node load-tests/index.js --level=smoke --test=all",
    "load:custom": "node load-tests/index.js"
  },
  "keywords": [
    "api",
    "authentication",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "axe-core": "^4.11.4",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "chrome-launcher": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.1",
    "fastify": "^4.24.3",
    "google-ads-api": "^24.1.0",
    "google-auth-library": "^10.5.0",
    "groq-sdk": "^1.1.1",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^7.0.6",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.2",
    "lighthouse": "^10.4.0",
    "mongodb": "^7.0.0",
    "mongoose": "^7.7.0",
    "multer": "^2.2.0",
    "natural": "^6.10.4",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "openai": "^7.27.0",
    "papaparse": "^5.7.0",
    "puppeteer": "^21.11.0",
    "puppeteer-cluster": "^0.23.0",
    "react-email": "^6.8.1",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "stripe": "^20.3.1",
    "validator": "^13.11.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "archiver": "^5.3.2",
    "nodemon": "^3.0.1"
  }
}
