# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Set when the app runs behind a reverse proxy / load balancer so Express
# derives the real client IP from X-Forwarded-For. Auth rate limiting keys
# on the client IP, so this MUST be set in that kind of deployment.
# Accepts: "1" (trust first hop), "true", "loopback", a subnet, etc.
# Leave unset for a single host / local dev (behaviour is then unchanged).
# TRUST_PROXY=1

# Database Configuration
MONGO_URI=mongodb://localhost:27017/odito_dev
# Must be identical in python_workers/.env. Required when MONGO_URI (e.g. an
# Atlas mongodb+srv URI) has no /dbname path — otherwise this backend uses
# "test" while the Python workers default to "odito_dev".
# MONGO_DB_NAME=odito_dev

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here
# LEGACY web session token (`data.token`) lifetime for "remember me"
# password logins and for "Sign in with Google". Optional; default "7d".
# Non-remember-me password logins are always "1d". The web frontend
# consumes this token directly and has no refresh logic — do not shorten it.
# JWT_EXPIRY=7d

# --- Mobile session: short access token + rotating refresh token (Phase 2) ---
# Returned as `data.tokens` alongside the legacy `data.token`. A mobile
# client uses `data.tokens.*` and calls POST /api/auth/refresh.
# Mobile ACCESS token lifetime. Short by design. Accepts 30m / 1800s / 1h etc.
# ACCESS_TOKEN_EXPIRES_IN=30m
# Refresh (session) lifetime for a "remember me" login. Default 60d.
# REFRESH_TOKEN_EXPIRES_IN=60d
# Refresh (session) lifetime for a NON-"remember me" login. Optional; default 7d.
# REFRESH_TOKEN_EXPIRES_IN_SHORT=7d
# Max POST /api/auth/refresh calls per rate-limit window per (IP + token). Default 30.
# AUTH_REFRESH_MAX=30
# Access-token iss / aud claims (mobile tokens only; legacy tokens have neither).
# Change only if you also update every verifier. Defaults: "odito" / "odito-mobile".
# TOKEN_ISSUER=odito
# TOKEN_AUDIENCE=odito-mobile

# --- Auth rate limiting (all optional; production-safe defaults) ---
# Master kill switch — set to "false" to disable every auth limiter.
# AUTH_RATE_LIMIT_ENABLED=true
# Shared sliding window for all auth limiters, in ms. Default 900000 (15 min).
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# Max FAILED logins per window per (IP + email). Default 10.
# AUTH_LOGIN_MAX=10
# Max verify-email-otp / verify-reset-otp attempts per window per (IP + email). Default 20.
# AUTH_OTP_VERIFY_MAX=20
# Max forgot-password / generate-email-otp / resend-verification per window per (IP + email). Default 5.
# AUTH_OTP_REQUEST_MAX=5
# Max registrations per window per IP. Default 20.
# AUTH_REGISTER_MAX=20
# Max registrations per window per target email. Default 5.
# AUTH_REGISTER_EMAIL_MAX=5
# Max Google ID-token callback calls per window per IP. Default 20.
# AUTH_GOOGLE_MAX=20

# Service URLs
BACKEND_URL=http://localhost:5000
PYTHON_WORKER_URL=http://localhost:8000
VIDEO_WORKER_URL=http://localhost:9000

# Optional API Keys
GEMINI_API_KEY=your-gemini-api-key

# Claude / Anthropic — powers AI recommendation generation and the AI
# Campaign Builder (src/modules/aiCampaign/). Server-only; never exposed to
# the frontend, never stored in MongoDB. CLAUDE_API_KEY is accepted as an
# alias. Without a key, AI campaign generation returns HTTP 503 and the rest
# of the app is unaffected.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model used by the AI Campaign Builder. Falls back to CLAUDE_MODEL, then to
# a sane built-in default. Kept configurable because model names change.
# CLAUDE_CAMPAIGN_MODEL=claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6

# Public origin for social media files (Facebook/Instagram image + video posts). Meta FETCHES the media URL from the public
# internet, so it must be a public HTTPS origin that serves this backend's /storage/social_media/<project>/<file> paths (a
# reverse proxy, CDN or tunnel in front of storage). When unset, BACKEND_URL is used - so for media publishing either
# BACKEND_URL or this must be public HTTPS (not localhost / a private address). Restrict the public exposure to
# /storage/social_media/ only. Posts scheduled with media on a non-public origin are refused with MEDIA_URL_NOT_PUBLIC;
# text-only posts are unaffected.
# PUBLIC_MEDIA_BASE_URL=https://media.your-domain.example

# OpenAI — powers single-post AI content generation (src/modules/social_meta/service/aiContent/).
# Server-only: never expose it to the frontend (no NEXT_PUBLIC_ prefix) and never store it in MongoDB.
# The AI Strategy keeps using Claude (ANTHROPIC_API_KEY above). Without a key, POST
# /api/social/ai-content/generate returns HTTP 503 AI_UNAVAILABLE and nothing else is affected.
# OPENAI_POST_API_KEY is preferred (a key dedicated to post generation); OPENAI_API_KEY is the fallback.
OPENAI_POST_API_KEY=your-openai-post-api-key
# OPENAI_API_KEY=your-openai-api-key
# Model for single posts: SOCIAL_AI_CONTENT_MODEL -> OPENAI_MODEL -> built-in default (gpt-4.1-mini).
# Must support Structured Outputs (json_schema). Kept configurable because model names change.
# SOCIAL_AI_CONTENT_MODEL=gpt-4.1-mini
# OPENAI_MODEL=gpt-4.1-mini
# SOCIAL_AI_CONTENT_TIMEOUT_MS=60000
# SOCIAL_AI_CONTENT_MAX_OUTPUT_TOKENS=2000
# SOCIAL_AI_CONTENT_PROVIDER_RETRIES=1

# AI design (image) generation for approved posts — src/modules/social_meta/service/aiDesign/. OpenAI Images (GPT Image
# models). Key lookup: OPENAI_IMAGE_API_KEY -> OPENAI_POST_API_KEY -> OPENAI_API_KEY (server-only, never in the frontend).
# GPT Image models may require OpenAI organization verification. Without a key, POST /api/social/ai-design/generate returns 503.
# OPENAI_IMAGE_API_KEY=your-openai-image-api-key
# SOCIAL_AI_DESIGN_MODEL=gpt-image-1
# SOCIAL_AI_DESIGN_QUALITY=medium                     # low | medium | high | auto
# SOCIAL_AI_DESIGN_TIMEOUT_MS=120000
# SOCIAL_AI_DESIGN_RATE_MAX=10                        # per user per window (images cost more than text)
# SOCIAL_AI_DESIGN_RATE_WINDOW_MS=900000

# AI Campaign generation tuning (all optional — sensible defaults in
# src/modules/aiCampaign/constants/generationConfig.js)
# AI_CAMPAIGN_TIMEOUT_MS=90000
# AI_CAMPAIGN_MAX_OUTPUT_TOKENS=8000
# AI_CAMPAIGN_MAX_RETRIES=2
# AI_CAMPAIGN_MAX_DAILY_BUDGET=100000        # sanity cap on brief.dailyBudget (major units)
# AI_CAMPAIGN_RATE_LIMIT_ENABLED=true        # "false" disables the /generate limiter
# AI_CAMPAIGN_GENERATE_MAX=10                # generations per window per user
# AI_CAMPAIGN_GENERATE_WINDOW_MS=900000      # 15 min

# AI Campaign RSA creative-quality targets — Odito's own pre-publish bar,
# stricter than Google Ads' raw minimums (RSA_LIMITS in aiCampaignEnums.js).
# This is the fix for generations that were schema-valid but creatively thin
# (6 headlines / 3 descriptions -> "Average" Ad Strength in Google Ads). All
# optional — sensible defaults in generationConfig.js. Odito can optimize
# toward, but never guarantee, Google's own Ad Strength rating.
# AI_CAMPAIGN_HEADLINES_TARGET=15
# AI_CAMPAIGN_HEADLINES_QUALITY_MIN=12       # fresh AI generations must meet this to reach `ready`
# AI_CAMPAIGN_DESCRIPTIONS_TARGET=4
# AI_CAMPAIGN_DESCRIPTIONS_QUALITY_MIN=4
# AI_CAMPAIGN_ADS_TARGET=2                   # RSAs per ad group
# AI_CAMPAIGN_SITELINKS_TARGET=6             # capped by how many verified project URLs actually exist — see sitelinkResolver.js
# AI_CAMPAIGN_CALLOUTS_TARGET=4
# AI_CAMPAIGN_CALLOUTS_MIN=2
# AI_CAMPAIGN_SNIPPET_VALUES_TARGET=4
# AI_CAMPAIGN_SNIPPET_VALUES_MIN=3
# AI_CAMPAIGN_MAX_CREATIVE_REPAIRS=2         # bounded repair attempts before generation fails outright

# AI Campaign conversational EDITING tuning (Phase 4 — all optional,
# sensible defaults in src/modules/aiCampaign/constants/editingConfig.js)
# CLAUDE_EDIT_MODEL=claude-sonnet-4-6                # falls back to CLAUDE_CAMPAIGN_MODEL, then CLAUDE_MODEL
# AI_CAMPAIGN_EDIT_TIMEOUT_MS=60000
# AI_CAMPAIGN_EDIT_MAX_OUTPUT_TOKENS=4000
# AI_CAMPAIGN_EDIT_MAX_RETRIES=1
# AI_CAMPAIGN_INSTRUCTION_MAX_LENGTH=2000
# AI_CAMPAIGN_PROPOSAL_EXPIRY_MS=86400000    # 24h — a proposal not accepted by then is treated as expired
# AI_CAMPAIGN_ASSIST_MAX=20                  # assistant turns per window per user (shares AI_CAMPAIGN_RATE_LIMIT_ENABLED above)
# AI_CAMPAIGN_ASSIST_WINDOW_MS=900000        # 15 min

# All transactional email (authentication OTPs, billing/subscription
# receipts, audit-completed reports) is sent via src/modules/mail/, backed
# by Resend. Requires an account at resend.com; in production
# EMAIL_FROM_ADDRESS must be on a domain verified there, or sends will fail
# with "domain is not verified".
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# PULL Model Configuration
# Set to 'true' to enable PULL model (worker polling)
# Set to 'false' to use PUSH model (axios dispatch)
USE_PULL_MODEL=false

# Weekly Recheck Scheduler (runs the Quick Recheck pipeline, not a full Recrawl)
# Cron expression for how often to check for projects due a scheduled recheck
# (the 7-day-or-never-scraped eligibility window itself is enforced by
# SeoProject.getProjectsNeedingScrape(), not by this schedule).
# The older WEEKLY_RECRAWL_CRON / WEEKLY_RECRAWL_ENABLED names still work as a
# fallback; the WEEKLY_RECHECK_* names take precedence when both are set.
WEEKLY_RECHECK_CRON=0 3 * * *
# Set to 'false' to disable the scheduler entirely without a code change.
WEEKLY_RECHECK_ENABLED=true

# Deleted Project Purge Scheduler (Project Trash & Restore, Phase 3)
# Cron expression for how often to check for projects past their
# scheduled_purge_at (7 days after being moved to trash).
PROJECT_PURGE_CRON=0 4 * * *
# Set to 'false' to disable the purge scheduler entirely without a code change.
PROJECT_PURGE_ENABLED=true

# Stale Job Lock Recovery Scheduler
# Cron expression for how often to sweep jobs stuck in 'processing'.
STALE_LOCK_CRON=*/5 * * * *
# A job's claimed_at must be older than this (ms) to be considered stale.
STALE_LOCK_TIMEOUT_MS=600000
# Set to 'false' to disable the scheduler entirely without a code change.
STALE_LOCK_CLEANUP_ENABLED=true

# Social Media Publishing Scheduler (see socialSchedulerService.js)
# Cron expression for how often to check for due scheduled Facebook/
# Instagram posts (see socialSchedulerService.js/executeDuePublications()).
SOCIAL_SCHEDULER_CRON=* * * * *
# Deliberately OPT-IN, unlike this file's other schedulers above (which
# default ON). This one makes REAL, irreversible posts to a real, external
# Facebook/Instagram account the moment it runs, so ONLY the exact value
# "true" enables it — unset, "false", "TRUE", "1" are all DISABLED. The code
# default is disabled; this example ships "false" so copying it never turns
# on real publishing by accident. When disabled, the server logs a WARN at
# boot with the reason, and scheduled posts stay 'scheduled' until enabled.
SOCIAL_SCHEDULER_ENABLED=false
# A scheduled post that is more than this many MINUTES past its scheduled time
# (after downtime, a restart, or the scheduler being disabled) is NOT published
# automatically — it is marked failed (SCHEDULE_MISSED) and needs a deliberate
# "Retry Publish". Prevents stale posts going out days late. Default 60.
SOCIAL_SCHEDULER_MAX_LATENESS_MINUTES=60
# Automatic retry of a scheduled post after a TEMPORARY failure (Meta 5xx,
# rate limit, transient error). Never retried: invalid content, missing
# media/permission, expired authentication, permanent Meta rejections.
# Total attempts per post INCLUDING the first (4 = first try + 3 retries).
SOCIAL_PUBLISH_MAX_ATTEMPTS=4
# Delay before retry n = BASE * 2^(n-1), capped at MAX_DELAY (milliseconds).
# Rate limiting uses its own, longer base.
SOCIAL_PUBLISH_RETRY_BASE_MS=60000
SOCIAL_PUBLISH_RATE_LIMIT_BASE_MS=300000
SOCIAL_PUBLISH_RETRY_MAX_DELAY_MS=900000
# A post stuck in 'publishing' longer than this (ms) is presumed orphaned by a
# crashed/restarted worker and is reconciled against Meta (never blindly
# re-published). Must comfortably exceed the longest real publish. Default 10 min.
SOCIAL_PUBLISH_STALE_MS=600000
# After a publish whose outcome is UNKNOWN (request sent, no usable answer),
# wait this long (ms) before concluding "not found on Meta" means "not
# published", and stop re-checking after GIVE_UP minutes (the post then stays
# flagged for a person to verify on the platform).
SOCIAL_PUBLISH_RECONCILE_SETTLE_MS=120000
SOCIAL_PUBLISH_RECONCILE_GIVE_UP_MINUTES=1440
# Timeout (ms) for the final, post-creating Graph call (default 30000).
SOCIAL_PUBLISH_TIMEOUT_MS=30000

# Google OAuth / Business Profile Integration
# OAuth 2.0 Web application client used by this backend's own /auth/oauth/google/* flow
GOOGLE_CLIENT_ID=your-backend-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-backend-oauth-client-secret
# Must exactly match the live route: {BACKEND_URL}/api/auth/oauth/google/callback
GOOGLE_OAUTH_REDIRECT=http://localhost:5000/api/auth/oauth/google/callback
# The frontend's separate NextAuth Google OAuth client ID (accepted as an additional
# valid audience when verifying ID tokens on POST /auth/oauth/google/callback)
GOOGLE_NEXTAUTH_CLIENT_ID=your-frontend-nextauth-client-id.apps.googleusercontent.com
# Native "Sign in with Google" client IDs. A mobile Google Sign-In SDK issues
# an ID token whose `aud` is the PLATFORM client ID, not GOOGLE_CLIENT_ID /
# GOOGLE_NEXTAUTH_CLIENT_ID — set these so the mobile app can authenticate via
# POST /auth/oauth/google/callback. Both optional; leave blank until a mobile
# app exists. (See src/modules/user/config/googleAudiences.js.)
# GOOGLE_ANDROID_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=your-ios-oauth-client-id.apps.googleusercontent.com
# Optional comma-separated list of any ADDITIONAL accepted client IDs, for
# deployments needing more than the four named slots without a code change.
# GOOGLE_OAUTH_AUDIENCES=
# 32-byte hex key used to encrypt GoogleConnection refresh/access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
# 32-byte hex key used to encrypt WordPressConnection application passwords at
# rest. Deliberately separate from GOOGLE_TOKEN_ENCRYPTION_KEY so rotating one
# vendor's key never affects the other's connections.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORDPRESS_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
# API key for Google Places API (used by business search / local SEO features, unrelated to OAuth)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Meta (Facebook + Instagram) Integration — Social Media OAuth foundation (Phase 1)
# Meta App ID/Secret from the Meta Developer Console app ("Odito Social Platform")
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Must exactly match the live route: {BACKEND_URL}/api/social/meta/callback
META_REDIRECT_URI=http://localhost:5000/api/social/meta/callback
# 32-byte hex key, provisioned now for the token persistence Phase 2 will add.
# Deliberately separate from GOOGLE_TOKEN_ENCRYPTION_KEY / WORDPRESS_CREDENTIAL_ENCRYPTION_KEY
# so rotating one vendor's key never affects another's connections.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_TOKEN_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
# Single source of truth for the Graph API version — verify this matches
# what's configured in the Meta Developer Console before relying on it.
META_GRAPH_API_VERSION=v21.0
# The OAuth callback redirects the browser back to CORS_ORIGIN (the first
# entry if several are comma-separated). It is read per request through
# config/env.js getFrontendUrl(); in production a missing CORS_ORIGIN is a
# hard configuration error — it never falls back to localhost.
# Token lifetime: the callback exchanges the short-lived user token for a
# long-lived one (grant_type=fb_exchange_token) before fetching Page tokens,
# and each selected Page token is checked with Meta's debug_token endpoint
# (needs META_APP_ID + META_APP_SECRET) to persist its real expiry.
# Set to true to log full Google API error diagnostics and access-token scope
# checks for Business Profile calls. Leave unset/false in normal operation.
GBP_DEBUG=false

# Google Ads Integration
# Reuses the same GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET/GOOGLE_OAUTH_REDIRECT
# above (separate consent screen only - see oauth.routes.js's /google-ads/start).
# App-level developer token issued to your Google Ads Manager account -
# https://developers.google.com/google-ads/api/docs/get-started/dev-token
# Ships in "test" mode (sandbox accounts only) until Google approves
# basic/standard access. Required for any googleAdsService.js call to work.
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token


# ── Social Media AI: calendar allowance (REQUIRED DECISION before production) ──
# Calendar posts the AI may plan per account per UTC month, PER PLAN. A value is a whole number (0 = not included in the plan) or the word
# "unlimited" (a deliberate choice). Odito's plans.js carries the entitlement as socialAi.calendarPostsPerMonth (null = not decided yet); the
# setting below supplies it at deploy time until the number is written there. Both set to different values = the server refuses to start.
# In PRODUCTION a plan with nothing decided is REFUSED (calendar generation answers 503 QUOTA_NOT_CONFIGURED) - it is never treated as
# unlimited. Outside production an unset value means unlimited, so local development needs no setup. A dearer plan may not include fewer
# posts than a cheaper one (the server refuses to start). The business owner chooses the numbers; none is built in.
# SOCIAL_AI_STARTER_CALENDAR_POSTS_PER_MONTH=
# SOCIAL_AI_PRO_CALENDAR_POSTS_PER_MONTH=
# SOCIAL_AI_PREMIUM_CALENDAR_POSTS_PER_MONTH=
# Accounts with NO plan (never subscribed, or a retired plan id): a number is a trial allowance, 0 = none. Unset in production = PLAN_REQUIRED (403).
# SOCIAL_AI_NO_PLAN_CALENDAR_POSTS_PER_MONTH=
# Older single number for every account that has no setting of its own (a positive whole number; leave unset to not use it).
# SOCIAL_AI_CALENDAR_QUOTA_USER_POSTS_PER_MONTH=
# Optional cap per project per month (positive whole number).
# SOCIAL_AI_CALENDAR_QUOTA_PROJECT_POSTS_PER_MONTH=
# Calendars one account may have generating at once (default 3).
# SOCIAL_AI_CALENDAR_QUOTA_MAX_IN_FLIGHT_PER_USER=3
# Provider prices in USD per MILLION tokens - only for the cost estimate in the usage ledger (unset = tokens and calls are recorded, cost is not).
# SOCIAL_AI_COST_USD_PER_MTOK_INPUT=
# SOCIAL_AI_COST_USD_PER_MTOK_OUTPUT=

# ── Social Media AI: durable calendar generation ──
# The generation is a job in MongoDB with a lease; any API instance takes over a calendar whose worker died. Defaults are production-ready.
# SOCIAL_AI_CALENDAR_LEASE_MS=90000
# SOCIAL_AI_CALENDAR_HEARTBEAT_MS=30000
# SOCIAL_AI_CALENDAR_RUN_ATTEMPTS=3
# SOCIAL_AI_CALENDAR_RECOVERY_ENABLED=true             # keep ON on every instance; false disables the once-a-minute takeover sweep
# SOCIAL_AI_CALENDAR_RECOVERY_CRON=* * * * *
# SOCIAL_AI_CALENDAR_MAX_POSTS=200

# ── Meta OAuth state ──
# Signing key for the OAuth state. Unset = derived from JWT_SECRET (works, but rotating JWT_SECRET then invalidates in-flight connects).
# META_OAUTH_STATE_SECRET=
# true = a connection can only be completed in the browser that started it (httpOnly cookie). Requires the API and the app on the same site
# (or SameSite-compatible domains); leave false for a cross-site deployment until verified on the real domains.
# META_OAUTH_REQUIRE_BROWSER_BINDING=false

# ── Monitoring ──
# GET /healthz (liveness) and GET /readyz (readiness) are public and expose no details. GET /metrics (Prometheus) needs
#   Authorization: Bearer <METRICS_TOKEN>
# In production it does not exist unless this is set to at least 16 random characters. Generate one with:  openssl rand -hex 24
# METRICS_TOKEN=

# ── AuditIQ tab (issue detail page) ──
# Booking page for the "Book a Strategy Call" button (must be an https URL, e.g. your Calendly/Cal.com link).
# Unset = the button tells the user booking is not configured; Odito never invents a booking URL.
# AUDITIQ_BOOKING_URL=
# Staff notification for Express Fix / Technical Audit + Fix / Expert Fix requests goes to SALES_NOTIFICATION_EMAIL
# (the same address used for custom-plan requests). Unset = requests are stored but nobody is emailed.

# ── Keyword rankings: desktop + mobile ──
# Every keyword scan (onboarding, add keyword, rescan) requests the Google organic SERP for BOTH desktop and mobile, so
# each scan makes 2 DataForSEO organic requests instead of 1 (price per request is the same for either device).
# Customer keyword limits and the rescan/add rate limits still count KEYWORDS/scans, not provider requests.
# Set to false (or 0 / off / no / disabled) to go back to desktop-only scans (existing mobile data is kept, just no longer refreshed). Default: on.
# KEYWORD_MOBILE_RANKING_ENABLED=true
# Max organic SERP requests Odito keeps in flight at once (desktop + mobile combined). Default 6.
# DATAFORSEO_SERP_MAX_CONCURRENT=6
